CONFIG_TINYUSB_CDC_ENABLED=y
# CONFIG_SPIRAM is not set
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
# CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID is not set
CONFIG_TINYUSB_DESC_CUSTOM_VID=0xAFF1
# CONFIG_TINYUSB_DESC_USE_DEFAULT_PID is not set
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x52B6
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Affine"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Affine Uni Bootloader ES3S"
CONFIG_TINYUSB_DESC_CDC_STRING="Uni protocol"
