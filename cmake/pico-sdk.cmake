# Read-only external SDK validation; never fetch during configuration.
if(NOT PICO_SDK_PATH AND DEFINED ENV{PICO_SDK_PATH})
    set(PICO_SDK_PATH "$ENV{PICO_SDK_PATH}")
endif()
if(NOT PICO_SDK_PATH)
    message(FATAL_ERROR "Supply -DPICO_SDK_PATH=<pico-sdk 2.3.1>")
endif()
get_filename_component(PICO_SDK_PATH "${PICO_SDK_PATH}" ABSOLUTE)
set(AFFINE_PICO_SDK_COMMIT 079c6f39023649b154152db30f1d781e884879bc)
set(AFFINE_TINYUSB_COMMIT 86ad6e56c1700e85f1c5678607a762cfe3aa2f47)
foreach(_file pico_sdk_version.cmake external/pico_sdk_import.cmake
        lib/tinyusb/src/tusb.h lib/tinyusb/src/class/cdc/cdc_device.c)
    if(NOT EXISTS "${PICO_SDK_PATH}/${_file}")
        message(FATAL_ERROR "Incomplete pico-sdk: missing ${_file}")
    endif()
endforeach()
file(READ "${PICO_SDK_PATH}/pico_sdk_version.cmake" _pico_version)
foreach(_pair "MAJOR;2" "MINOR;3" "REVISION;1")
    list(GET _pair 0 _part)
    list(GET _pair 1 _number)
    if(NOT _pico_version MATCHES "set\\(PICO_SDK_VERSION_${_part} ${_number}\\)")
        message(FATAL_ERROR "pico-sdk 2.3.1 required")
    endif()
endforeach()
find_package(Git REQUIRED)
if(EXISTS "${PICO_SDK_PATH}/.git" AND NOT EXISTS "${PICO_SDK_PATH}/lib/tinyusb/.git")
    message(FATAL_ERROR "Git SDK requires the initialized pinned TinyUSB submodule")
endif()
foreach(_pair "${PICO_SDK_PATH};${AFFINE_PICO_SDK_COMMIT}"
              "${PICO_SDK_PATH}/lib/tinyusb;${AFFINE_TINYUSB_COMMIT}")
    list(GET _pair 0 _path)
    list(GET _pair 1 _expected)
    if(EXISTS "${_path}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -c "safe.directory=${_path}"
            -C "${_path}" rev-parse HEAD OUTPUT_VARIABLE _actual
            OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0 OR NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "${_path}: expected ${_expected}, found ${_actual}")
        endif()
    endif()
endforeach()
if(PICO_TINYUSB_PATH AND NOT PICO_TINYUSB_PATH STREQUAL "${PICO_SDK_PATH}/lib/tinyusb")
    message(FATAL_ERROR "Use the pinned SDK TinyUSB submodule")
endif()
set(PICO_TINYUSB_PATH "${PICO_SDK_PATH}/lib/tinyusb" CACHE PATH "Pinned TinyUSB" FORCE)
