set(AFFINE_CH32_SDK_DIR "" CACHE PATH "External pinned openwch/ch32v20x checkout")
set(AFFINE_CH32_SDK_COMMIT b375bbbc7dfe8642d6fb7c17e6d3207ee1c3c9c1)
if(NOT AFFINE_CH32_SDK_DIR)
    message(FATAL_ERROR "CH32V203 needs -DAFFINE_CH32_SDK_DIR=<pinned ch32v20x checkout>")
endif()
get_filename_component(AFFINE_CH32_SDK_DIR "${AFFINE_CH32_SDK_DIR}" ABSOLUTE)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -c "safe.directory=${AFFINE_CH32_SDK_DIR}"
    -C "${AFFINE_CH32_SDK_DIR}" rev-parse HEAD OUTPUT_VARIABLE _commit
    OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR NOT _commit STREQUAL AFFINE_CH32_SDK_COMMIT)
    message(FATAL_ERROR "CH32 SDK must be Git checkout ${AFFINE_CH32_SDK_COMMIT}; found ${_commit}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -c "safe.directory=${AFFINE_CH32_SDK_DIR}"
    -C "${AFFINE_CH32_SDK_DIR}" diff --quiet HEAD RESULT_VARIABLE _dirty)
if(NOT _dirty EQUAL 0)
    message(FATAL_ERROR "CH32 SDK has modified tracked files")
endif()
set(CH32_SRC "${AFFINE_CH32_SDK_DIR}/EVT/EXAM/SRC")
set(CH32_USBD "${AFFINE_CH32_SDK_DIR}/EVT/EXAM/USB/USBD/SimulateCDC/User/USBLIB")
set(CH32_SDK_SOURCES)
foreach(driver IN ITEMS rcc gpio flash misc exti pwr)
    list(APPEND CH32_SDK_SOURCES "${CH32_SRC}/Peripheral/src/ch32v20x_${driver}.c")
endforeach()
set(CH32_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/ch32-sdk-adapted")
if(AFFINE_BOOT_CH32_USB STREQUAL "usbd")
    foreach(driver IN ITEMS core init int mem regs sil)
        list(APPEND CH32_SDK_SOURCES "${CH32_USBD}/USB-Driver/src/usb_${driver}.c")
    endforeach()
    set(CH32_ADAPTED usb_prop.c usb_pwr.c usb_istr.c)
else()
    set(CH32_ADAPTED ch32v20x_usbfs_device.c)
endif()
foreach(file IN LISTS CH32_SDK_SOURCES)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "Pinned CH32 SDK missing ${file}")
    endif()
endforeach()
foreach(file IN ITEMS Core/core_riscv.h Peripheral/inc/ch32v20x.h Startup/startup_ch32v20x_D6.S Ld/Link.ld)
    if(NOT EXISTS "${CH32_SRC}/${file}")
        message(FATAL_ERROR "Pinned CH32 SDK missing ${file}")
    endif()
endforeach()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CH32_TARGET_DIR}/prepare_sdk.py"
    "${AFFINE_CH32_SDK_DIR}" "${CH32_GENERATED}" "${AFFINE_BOOT_CH32_USB}" RESULT_VARIABLE _prepare)
if(NOT _prepare EQUAL 0)
    message(FATAL_ERROR "Pinned CH32 SDK adaptation failed")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CH32_TARGET_DIR}/prepare_sdk.py")
foreach(file IN LISTS CH32_ADAPTED)
    list(APPEND CH32_SDK_SOURCES "${CH32_GENERATED}/${file}")
endforeach()
list(APPEND CH32_SDK_SOURCES "${CH32_GENERATED}/startup.S")
