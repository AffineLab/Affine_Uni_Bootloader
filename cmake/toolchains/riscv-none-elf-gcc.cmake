set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(AFFINE_RISCV_TOOLCHAIN_ROOT "$ENV{RISCV_NONE_ELF_TOOLCHAIN_ROOT}" CACHE PATH "xPack RISC-V root or bin directory")
find_program(AFFINE_RISCV_GCC NAMES riscv-none-elf-gcc riscv-none-elf-gcc.exe
    HINTS "${AFFINE_RISCV_TOOLCHAIN_ROOT}" "${AFFINE_RISCV_TOOLCHAIN_ROOT}/bin" REQUIRED)
get_filename_component(_riscv_bin "${AFFINE_RISCV_GCC}" DIRECTORY)
set(CMAKE_C_COMPILER "${AFFINE_RISCV_GCC}")
set(CMAKE_ASM_COMPILER "${AFFINE_RISCV_GCC}")
foreach(pair IN ITEMS "CMAKE_AR;ar" "CMAKE_RANLIB;ranlib" "CMAKE_OBJCOPY;objcopy" "CMAKE_SIZE;size")
    list(GET pair 0 var)
    list(GET pair 1 tool)
    find_program(${var} NAMES riscv-none-elf-${tool} HINTS "${_riscv_bin}" NO_DEFAULT_PATH REQUIRED)
endforeach()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_EXECUTABLE_SUFFIX_C ".elf")
set(CMAKE_EXECUTABLE_SUFFIX_ASM ".elf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AFFINE_RISCV_TOOLCHAIN_ROOT)
